<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>Between Us — a shelf of writings</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --grey-0:#242427;
    --grey-1:#2b2b2f;
    --grey-2:#38383d;
    --grey-3:#4a4a51;
    --ink:#e9e6df;
    --ink-dim:#9c9a97;
    --gold:#c8a45c;
    --gold-dim:#8d7644;
    --blue:#6f9bc9;
    --paper:#f4efe4;
    --paper-shadow:#d8cdb2;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; height:100%;
    background:var(--grey-0);
    color:var(--ink);
    font-family:'Source Serif 4', serif;
    overflow:hidden;
    -webkit-tap-highlight-color:transparent;
  }
  ::selection{background:var(--gold-dim); color:var(--paper);}

  /* subtle ambient grain / vignette so the flat grey has depth */
  #bg-vignette{
    position:fixed; inset:0; pointer-events:none; z-index:0;
    background:
      radial-gradient(ellipse at 50% 20%, rgba(255,255,255,0.05), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(0,0,0,0.45), transparent 60%);
  }

  /* ---------------- SHELF VIEW ---------------- */
  #shelf-view{
    position:relative; z-index:1;
    height:100%; width:100%;
    display:flex; flex-direction:column; align-items:center;
    padding:7vh 6vw 4vh;
    transition:opacity .5s ease, filter .5s ease;
  }
  #shelf-view.hidden{opacity:0; pointer-events:none;}

  .site-eyebrow{
    font-family:'Inter',sans-serif; font-size:11px; letter-spacing:.22em;
    text-transform:uppercase; color:var(--gold); margin-bottom:10px;
  }
  .site-title{
    font-family:'Fraunces', serif; font-weight:600; font-style:italic;
    font-size:clamp(28px,7vw,40px); margin:0 0 6px;
    color:var(--ink); text-align:center; letter-spacing:.01em;
  }
  .site-sub{
    font-family:'Inter',sans-serif; font-size:13px; color:var(--ink-dim);
    text-align:center; max-width:320px; line-height:1.6; margin-bottom:6vh;
  }

  .shelf-scroll{
    width:100%; max-width:640px; overflow-y:auto; flex:1;
    padding-bottom:4vh;
  }
  .shelf-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(120px,1fr));
    gap:28px 22px;
    width:100%;
  }

  .book-slot{ display:flex; flex-direction:column; align-items:center; }
  .book-slot-label{
    font-family:'Inter',sans-serif; font-size:11.5px; color:var(--ink-dim);
    margin-top:12px; text-align:center; line-height:1.4; max-width:130px;
  }
  .book-slot-label b{ color:var(--ink); font-weight:500; display:block; font-size:12.5px; margin-bottom:2px;}

  /* real book cover */
  .book-cover{
    position:relative; width:120px; aspect-ratio:900/1279;
    border-radius:2px 5px 5px 2px;
    cursor:pointer; background:#000;
    box-shadow:
      -2px 0 0 0 #cbbfa0,
      -4px 2px 6px -2px rgba(0,0,0,.5),
      0 10px 18px -6px rgba(0,0,0,.65);
    transition:transform .35s cubic-bezier(.22,.9,.35,1), box-shadow .35s ease;
  }
  .book-cover img{
    width:100%; height:100%; object-fit:cover; display:block;
    border-radius:2px 5px 5px 2px;
  }
  .book-cover::after{
    content:""; position:absolute; inset:0; border-radius:2px 5px 5px 2px;
    box-shadow: inset 3px 0 4px rgba(0,0,0,.35);
  }
  .book-slot:hover .book-cover{
    transform:translateY(-4px) rotate(-1deg);
    box-shadow:
      -2px 0 0 0 #cbbfa0,
      -4px 2px 6px -2px rgba(0,0,0,.5),
      0 16px 26px -8px rgba(0,0,0,.7);
  }
  .book-cover:focus-visible{ outline:2px solid var(--gold); outline-offset:4px; }

  /* ghost / invisible placeholder book */
  .book-ghost{
    width:120px; aspect-ratio:900/1279;
    border-radius:2px 5px 5px 2px;
    border:1.5px dashed rgba(233,230,223,.16);
    display:flex; align-items:center; justify-content:center;
    position:relative;
    transition:border-color .3s ease, background .3s ease;
  }
  .book-ghost::before{ /* spine hint */
    content:""; position:absolute; left:6px; top:6px; bottom:6px;
    width:1px; background:rgba(233,230,223,.12);
  }
  .book-ghost .plus{
    font-family:'Inter',sans-serif; font-size:20px; font-weight:400;
    color:rgba(233,230,223,.25); transition:color .3s ease;
  }
  .book-slot.empty:hover .book-ghost{
    border-color:rgba(200,164,92,.45);
    background:rgba(200,164,92,.04);
  }
  .book-slot.empty:hover .plus{ color:var(--gold); }
  .book-slot.empty .book-slot-label{ opacity:.55; }

  /* ---------------- ZOOM TRANSITION GHOST ---------------- */
  #zoom-ghost{
    position:fixed; z-index:50; pointer-events:none;
    border-radius:2px 5px 5px 2px; overflow:hidden;
    box-shadow:0 30px 60px -12px rgba(0,0,0,.6);
    opacity:0;
  }
  #zoom-ghost img{ width:100%; height:100%; object-fit:cover; display:block; }

  /* ---------------- READER VIEW ---------------- */
  #reader-view{
    position:fixed; inset:0; z-index:20;
    display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none;
    transition:opacity .4s ease;
  }
  #reader-view.active{ opacity:1; pointer-events:auto; }

  .reader-topbar{
    position:absolute; top:0; left:0; right:0;
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 20px; z-index:5;
    font-family:'Inter',sans-serif;
  }
  .reader-title-chip{
    font-size:11.5px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--ink-dim);
  }
  .close-btn{
    width:34px; height:34px; border-radius:50%; border:1px solid var(--grey-3);
    background:var(--grey-1); color:var(--ink-dim);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; font-size:16px; line-height:1;
    transition:background .2s ease, color .2s ease, transform .2s ease;
  }
  .close-btn:hover{ background:var(--grey-2); color:var(--ink); transform:rotate(90deg); }

  .book-stage-wrap{
    width:100%; height:100%;
    display:flex; align-items:center; justify-content:center;
  }
  .book-stage{
    position:relative;
    width:340px; height:498px;
    transform-origin:center center;
  }

  .book-3d{
    position:relative; width:100%; height:100%;
    perspective:1800px;
  }

  /* base page beneath the flipping leaf (shows current content instantly) */
  .page-base{
    position:absolute; inset:0;
    background:var(--paper);
    border-radius:3px;
    box-shadow:0 24px 50px -10px rgba(0,0,0,.55), 0 2px 0 rgba(0,0,0,.2);
    overflow:hidden;
  }

  /* stacked leaf-edge indicators: remaining pages (right) & read pages (left) */
  .edge-stack{
    position:absolute; top:6px; bottom:6px; width:10px; pointer-events:none;
  }
  .edge-stack.right{ right:-4px; border-radius:0 3px 3px 0; }
  .edge-stack.left{ left:-4px; border-radius:3px 0 0 3px; }
  .edge-stack span{
    position:absolute; left:0; right:0; top:0; bottom:0;
    background:linear-gradient(90deg, var(--paper-shadow), #c3b48c);
    border-radius:inherit;
  }

  .page-content{
    position:absolute; inset:0;
    padding:38px 26px 34px;
    display:flex; flex-direction:column;
    font-family:'Source Serif 4', serif;
    color:#26231c;
  }
  .page-content .running-head{
    font-family:'Inter',sans-serif; font-size:8.5px; letter-spacing:.16em;
    text-transform:uppercase; color:#a99a7c; text-align:center; margin-bottom:16px;
  }
  .page-content .ptext{
    font-size:12.6px; line-height:1.62; text-align:justify;
    flex:1; overflow:hidden;
  }
  .page-content .ptext p{ margin:0 0 10px; text-indent:14px; }
  .page-content .ptext p.noindent{ text-indent:0; }
  .page-content .ptext p.center{ text-align:center; text-indent:0; }
  .page-content .ptext p.italic{ font-style:italic; }
  .page-content .pnum{
    font-family:'Inter',sans-serif; font-size:9px; color:#a99a7c;
    text-align:center; margin-top:8px;
  }
  .title-page{
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    height:100%; text-align:center;
  }
  .title-page .eyebrow{ font-family:'Inter',sans-serif; font-size:9px; letter-spacing:.2em; color:var(--gold-dim); text-transform:uppercase; margin-bottom:14px;}
  .title-page h1{
    font-family:'Fraunces',serif; font-weight:600; font-style:italic;
    font-size:26px; margin:0 0 10px; color:#26231c; line-height:1.15;
  }
  .title-page p{ font-family:'Source Serif 4', serif; font-style:italic; font-size:12px; color:#5b543f; max-width:220px; margin:0 0 20px;}
  .title-page .by{ font-family:'Inter',sans-serif; font-size:11px; letter-spacing:.06em; color:#8a7f5e; }

  /* the flipping leaf: single full page, hinged at the left (spine) edge */
  .leaf{
    position:absolute; top:0; bottom:0; left:0; width:100%;
    transform-style:preserve-3d;
    transform-origin:left center;
    transition:transform .7s cubic-bezier(.55,.06,.27,1.1);
    z-index:10;
  }
  .leaf .face{
    position:absolute; inset:0; backface-visibility:hidden;
    background:var(--paper); border-radius:3px;
    box-shadow:0 10px 30px -8px rgba(0,0,0,.4);
    overflow:hidden;
  }
  .leaf .face.back{ transform:rotateY(180deg); }
  .leaf.flip{ transform:rotateY(-180deg); }
  .leaf.flip-back{ transform:rotateY(180deg); }

  .reader-controls{
    position:absolute; bottom:0; left:0; right:0;
    display:flex; align-items:center; justify-content:center; gap:26px;
    padding:20px 0 26px;
  }
  .nav-btn{
    width:42px; height:42px; border-radius:50%;
    background:var(--grey-1); border:1px solid var(--grey-3);
    color:var(--ink); cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-size:16px; transition:background .2s ease, opacity .2s ease, transform .15s ease;
  }
  .nav-btn:hover:not(:disabled){ background:var(--grey-2); transform:translateY(-1px); }
  .nav-btn:disabled{ opacity:.25; cursor:default; }
  .page-indicator{
    font-family:'Inter',sans-serif; font-size:11.5px; color:var(--ink-dim);
    min-width:64px; text-align:center; letter-spacing:.03em;
  }

  @media (max-width:400px){
    .book-stage{ width:300px; height:440px; }
  }

  [hidden]{ display:none !important; }
</style>
</head>
<body>

<div id="bg-vignette"></div>

<!-- SHELF -->
<section id="shelf-view">
  <div class="site-eyebrow">a growing shelf</div>
  <h1 class="site-title">Between Us</h1>
  <p class="site-sub">Personal writings on faith, borders, and the people met along the way. Tap a cover to open it.</p>

  <div class="shelf-scroll">
    <div class="shelf-grid" id="shelf-grid"></div>
  </div>
</section>

<!-- ZOOM TRANSITION GHOST -->
<div id="zoom-ghost"><img id="zoom-ghost-img" alt=""></div>

<!-- READER -->
<section id="reader-view" aria-hidden="true">
  <div class="reader-topbar">
    <span class="reader-title-chip" id="reader-title-chip">Between You and Me</span>
    <button class="close-btn" id="close-btn" aria-label="Close book">&#10005;</button>
  </div>

  <div class="book-stage-wrap">
    <div class="book-stage" id="book-stage">
      <div class="book-3d" id="book-3d">
        <div class="page-base" id="page-base">
          <div class="edge-stack right" id="edge-right"></div>
          <div class="edge-stack left" id="edge-left"></div>
          <div class="page-content" id="page-content-base"></div>
        </div>
        <div class="leaf" id="leaf">
          <div class="face front page-content" id="leaf-front"></div>
          <div class="face back page-content" id="leaf-back"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="reader-controls">
    <button class="nav-btn" id="prev-btn" aria-label="Previous page">&#8249;</button>
    <span class="page-indicator" id="page-indicator">1 / 1</span>
    <button class="nav-btn" id="next-btn" aria-label="Next page">&#8250;</button>
  </div>
</section>

